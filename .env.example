# Base URL of the Vylore FastAPI backend, including the /api/v1 prefix.
NEXT_PUBLIC_API_URL=https://api.vylore.in/api/v1

# Gates the public storefront behind a "coming soon" page (see
# src/config/launch.ts and src/proxy.ts). Only "/" (ComingSoon) and /admin,
# /login stay reachable while this is unset or anything other than "false".
# Set to "false" once ready to launch.
COMING_SOON=true
